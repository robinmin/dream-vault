{
  "name": "dream-vault",
  "version": "0.1.0",
  "description": "Obsidian vault template with AI-augmented content creation, GitHub sync, and Cloudflare R2 backup",
  "type": "module",
  "private": true,
  "bin": {
    "dream-vault": "./src/cli/index.ts"
  },
  "scripts": {
    "check": "bun biome check src/ --error-on-warnings && bun run typecheck && bun run test-pre-check",
    "test-pre-check": "spur rule run --preset recommended --fail-on warning",
    "test-post-check": "spur rule run --preset recommended --rule coverage-gate --fail-on warning",

    "lint": "biome lint src/",
    "format": "biome format src/ --write",
    "format:check": "biome format src/",
    "typecheck": "tsc --noEmit",
    "autofix": "biome check --write src/",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dv": "bun src/cli/index.ts",
    "build": "bun build src/cli/index.ts --compile --outfile scripts/dv",
    "dv:install": "./scripts/dream-vault.sh install",
    "dv:list": "./scripts/dream-vault.sh list",
    "dv:sync": "./scripts/dream-vault.sh sync"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@logtape/logtape": "^2.1.1",
    "@logtape/pretty": "^2.1.1",
    "commander": "^14.0.3",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  }
}
