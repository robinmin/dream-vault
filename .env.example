# Dream Vault — GitHub Secrets Reference
# =============================================================================
# Set these via: gh secret set <NAME> --body <value>
# Or via: GitHub repo → Settings → Secrets and variables → Actions
# =============================================================================

# Cloudflare R2 account ID (found in Cloudflare dashboard → R2 → Overview)
CLOUDFLARE_R2_ACCOUNT_ID=

# Cloudflare R2 bucket name for vault backup
CLOUDFLARE_R2_BUCKET_NAME=

# R2 access key ID (created in Cloudflare → R2 → Manage R2 API Tokens)
CLOUDFLARE_R2_ACCESS_KEY_ID=

# R2 secret access key (created alongside the access key ID)
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
